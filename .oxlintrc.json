{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import"],
  "options": {
    "typeAware": true,
    "reportUnusedDisableDirectives": "warn"
  },
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",
    "typescript/consistent-type-imports": ["warn", { "fixStyle": "inline-type-imports" }],
    "typescript/no-deprecated": "warn",
    "typescript/no-unsafe-type-assertion": "off",
    // Typed SQL row helpers (`one<Row>(sql)`) name their result type with a single-use parameter.
    "typescript/no-unnecessary-type-parameters": "off",
    // tsc already checks exhaustive switches (noImplicitReturns); this rule flags them.
    "typescript/consistent-return": "off",
    "oxc/no-map-spread": "off",
    "import/no-unassigned-import": "off",
    "no-shadow": "off",
    "unicorn/consistent-function-scoping": "off",
    "no-await-in-loop": "off"
  },
  "overrides": [
    {
      "files": ["src/**/*.ts"],
      "rules": { "no-console": "error" }
    },
    {
      // Everything the CLI prints goes through its ui, which handles colour, the gutter and piped output.
      "files": ["src/cli/ui.ts"],
      "rules": { "no-console": "off" }
    },
    {
      "files": ["src/triage/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              { "group": ["node:*", "@googleapis/*", "googleapis", "google-auth-library", "@earendil-works/*"], "message": "triage/ is pure: no I/O. Inject what you need through a port (see src/triage/stages)." },
              {
                "group": ["**/gmail/**", "**/store/**", "**/actions/**", "**/agent/**", "**/daemon/**", "**/learn/**", "**/cli/**", "**/config.ts"],
                "message": "triage/ is pure and depends on nothing else in src/."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/model/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/gmail/**", "**/actions/**", "**/store/**", "**/daemon/**", "@googleapis/*", "googleapis", "google-auth-library"],
                "message": "model/ only turns evidence into a verdict. It never reaches Gmail, the database or anything that acts."
              },
              { "group": ["node:sqlite", "pg", "@electric-sql/*", "drizzle-orm", "drizzle-orm/*"], "message": "Only src/store opens a database. Take an Sql (src/store/sql.ts)." }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/dashboard/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/gmail/**", "**/actions/**", "**/agent/**", "**/daemon/**", "@googleapis/*", "googleapis", "google-auth-library"],
                "message": "dashboard/ shows the database and records what the user teaches sift (src/learn). It never reaches Gmail or changes the mailbox."
              },
              { "group": ["node:sqlite", "pg", "@electric-sql/*", "drizzle-orm", "drizzle-orm/*"], "message": "Only src/store opens a database. Take an Sql (src/store/sql.ts)." },
              { "group": ["**/store/store.ts", "**/store/db.ts", "**/store/split.ts"], "message": "Only src/cli and src/daemon/run.ts open databases. Take the Sql you are given; the dashboard asks People (src/store/people.ts)." }
            ]
          }
        ]
      }
    },
    {
      "files": ["web/src/**/*.ts", "web/src/**/*.tsx"],
      "plugins": ["typescript", "unicorn", "oxc", "import", "react"],
      "env": { "browser": true },
      "rules": { "react/react-in-jsx-scope": "off" }
    },
    {
      "files": ["web/src/views/**/*.tsx", "web/src/components/**/*.tsx", "web/src/lib/**/*.ts", "web/src/lib/**/*.tsx", "web/src/App.tsx"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              { "group": ["@base-ui/**"], "message": "Only web/src/system imports Base UI. Use or extend a part from '@/system' (docs/DESIGN.md)." }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/store/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              { "group": ["@googleapis/*", "googleapis", "google-auth-library"], "message": "Only src/gmail talks to Google. Use the Mailbox port in src/actions/mailbox.ts." },
              { "group": ["@earendil-works/*"], "message": "Only src/model talks to model providers. Use the Judge port in src/triage/stages/model.ts." }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/actions/**/*.ts", "src/daemon/**/*.ts", "src/learn/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              { "group": ["@googleapis/*", "googleapis", "google-auth-library"], "message": "Only src/gmail talks to Google. Use the Mailbox port in src/actions/mailbox.ts." },
              { "group": ["@earendil-works/*"], "message": "Only src/model talks to model providers. Use the Judge port in src/triage/stages/model.ts." },
              { "group": ["node:sqlite", "pg", "@electric-sql/*", "drizzle-orm", "drizzle-orm/*"], "message": "Only src/store opens a database. Take an Sql (src/store/sql.ts)." },
              { "group": ["**/store/store.ts", "**/store/db.ts", "**/store/split.ts"], "message": "Only src/cli and src/daemon/run.ts open databases. Take the Sql you are given; the dashboard asks People (src/store/people.ts)." }
            ]
          }
        ]
      }
    },
    {
      // What starts sift wires the store up, and the daemon's loop hands each pass one person's database.
      "files": ["src/cli/**/*.ts", "src/daemon/run.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              { "group": ["@googleapis/*", "googleapis", "google-auth-library"], "message": "Only src/gmail talks to Google. Use the Mailbox port in src/actions/mailbox.ts." },
              { "group": ["@earendil-works/*"], "message": "Only src/model talks to model providers. Use the Judge port in src/triage/stages/model.ts." },
              { "group": ["node:sqlite", "pg", "@electric-sql/*", "drizzle-orm", "drizzle-orm/*"], "message": "Only src/store opens a database. Take an Sql (src/store/sql.ts)." }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/gmail/**/*.ts", "src/*.ts"],
      "rules": { "no-restricted-imports": ["error", { "patterns": [{ "group": ["node:sqlite", "pg", "@electric-sql/*", "drizzle-orm", "drizzle-orm/*"], "message": "Only src/store opens a database. Take an Sql (src/store/sql.ts)." }] }] }
    }
  ],
  "ignorePatterns": [".claude/**", "node_modules/**", "data/**", "web/dist/**"]
}
