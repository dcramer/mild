{
  "name": "sift",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted inbox triage: labels, archives, filters and unsubscribes, using inference only when cheaper tiers abstain.",
  "bin": {
    "sift": "src/cli/main.ts"
  },
  "scripts": {
    "sift": "node --disable-warning=ExperimentalWarning src/cli/main.ts",
    "typecheck": "tsc --noEmit && pnpm --filter sift-web typecheck",
    "lint": "oxlint",
    "format": "oxlint --fix && oxfmt src tests web/src web/vite.config.ts vitest.config.ts",
    "format:check": "oxfmt --check src tests web/src web/vite.config.ts vitest.config.ts",
    "test": "vitest run",
    "knip": "knip",
    "check:fast": "pnpm typecheck && pnpm lint && pnpm knip && pnpm format:check",
    "check": "pnpm check:fast && pnpm test",
    "build:web": "pnpm --filter sift-web build",
    "start": "pnpm sift run",
    "dev": "pnpm sift dev",
    "db:generate": "drizzle-kit generate"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "0.31.11",
    "knip": "^6.45.1",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@11.8.0",
  "dependencies": {
    "@earendil-works/pi-ai": "^1.5.2",
    "@electric-sql/pglite": "0.5.16",
    "@googleapis/gmail": "^22.1.0",
    "drizzle-orm": "0.45.4",
    "google-auth-library": "^11.3.4",
    "pg": "8.23.1",
    "picocolors": "^1.1.1",
    "smol-toml": "^1.9.1",
    "zod": "^4.6.7"
  }
}
